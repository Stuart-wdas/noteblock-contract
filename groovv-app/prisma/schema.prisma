// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Users are identified by their wallet address (contractAddress here as PK)
model User {
  contractAddress String   @id
  createdAt       DateTime @default(now())
  displayName     String?
  avatarUrl       String?

  playlists       Playlist[]
  preferences     UserPreferences?
  // this token ownership dictates which user owns what
  tokenOwnerships TokenOwnership[] 
  streamSessions  StreamSession[]
}

// Global catalog
model Song {
  id        String   @id // is going to match song id in contract
  title     String
  artist    String
  genre     String
  length    Int
  releaseDate DateTime
  cid       String    // server file path or CDN key (never public if gated)
  cover     String
  albumId   Int?
  album     Album?    @relation(fields: [albumId], references: [id])
  token     TokenOwnership[]       // relation handled on TokenOwnership side
  PlaylistItem PlaylistItem[]
  StreamSession StreamSession[]
  @@index([title, artist, genre])
}

model Album {
  id         Int      @id @default(autoincrement())
  title       String
  artist      String
  genre       String
  cover       String
  releaseDate DateTime
  songs       Song[]
}

// On-chain ownership cache (synced from events or RPC, not a source of truth)
// the user ownership of a song can be tracked with this entry, 
// if a user buys a song, their balance is increased via event listening 
// and decreasd via listing and selling, once zero the db deletes the tokenownership
model TokenOwnership {
  id        Int      @id @default(autoincrement())
  owner     String   // wallet address
  song      Song    @relation(fields: [songid], references: [id])
  songid    String
  balance   String   // store as string for bigints; "0" means none
  updatedAt DateTime @default(now())
  user      User    @relation(fields: [owner], references: [contractAddress], onDelete: Cascade)
  @@index([owner, songid, id])
}

// Playlists are user-original content
model Playlist {
  id         Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
  isPublic  Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [contractAddress])
// songs consist of playlist items
// which references a playlist and a song
  songs     PlaylistItem[]
  // Optional cover chosen by user
  coverSongId String?
}

model PlaylistItem {
  id         Int      @id @default(autoincrement())
  playlistId Int
  songId     String
  playlist   Playlist @relation(fields: [playlistId], references: [id])
  song       Song     @relation(fields: [songId], references: [id])
  @@index([playlistId, songId])
}

// User preferences and playstyle
model UserPreferences {
  userId     String  @id
  user       User    @relation(fields: [userId], references: [contractAddress], onDelete: Cascade)
  playstyle  String  @default("Shuffle") // Shuffle | Loop | Discover (aligns with app enum)
  likedGenres String?
  likedArtists String?
}

// Stream sessions for audit and QoS
model StreamSession {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  startedAt DateTime @default(now())
  endedAt   DateTime?
  ipHash    String?  // privacy-preserving
  device    String?

  user      User     @relation(fields: [userId], references: [contractAddress], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id])

  @@index([userId, startedAt])
  @@index([songId, startedAt])
}
